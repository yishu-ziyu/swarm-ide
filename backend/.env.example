# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_wechat
REDIS_URL=redis://localhost:6379
LLM_PROVIDER=minimax

# MiniMax (OpenAI-compatible, default)
MINIMAX_API_KEY=replace_me
MINIMAX_BASE_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-M2.1

# OpenRouter (optional fallback)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
OPENROUTER_REASONING_EFFORT=

# Ark / 火山引擎方舟 (optional fallback)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=kimi-k2.5

# MCP 搜索（tavily/exa，mcp.json 中以 ${TAVILY_API_KEY} 形式引用）
TAVILY_API_KEY=
EXA_API_KEY=
