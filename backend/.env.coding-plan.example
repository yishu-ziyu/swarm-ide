# 火山引擎 Coding Plan 配置模板
# 复制此文件为 .env.local 并填入您的API Key

# LLM Provider (使用ark启用火山引擎)
LLM_PROVIDER=ark

# Ark / 火山引擎方舟 (OpenAI 兼容)
ARK_API_KEY=your-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=kimi-k2.5

# 可选配置
# ARK_API_KEY=your-key
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# ARK_MODEL=your-model
